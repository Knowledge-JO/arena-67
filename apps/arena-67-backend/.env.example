# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=9000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- Network ---
# mainnet (4663, REAL funds) is the default. testnet is 46630.
ARENA_NETWORK=mainnet
# RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Trading guardrails ---
MAX_TRADE_USD=25
MAX_SLIPPAGE_BPS=300
POOL_INDEX_SPAN=200000

# --- OpenServ agent (disabled by default; the REST desk works without it) ---
ENABLE_OPENSERV_AGENT=false
OPENSERV_AI_API_KEY=

# --- Coinbase CDP agent wallet (TEE-held signer) ---
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
AGENT_ACCOUNT_NAME=arena67-agent
# --- Email (login codes). Leave SMTP_HOST unset in development to print codes to the log.
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS, required) or 465 with SMTP_SECURE=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# "Arena 67 <codes@yourdomain.com>" or a bare address
SMTP_FROM_EMAIL=

# --- RPC budget (shared by the whole backend). Defaults suit the public endpoint,
# which refuses bursts of ~15+ requests. Raise these with a paid RPC_URL.
RPC_MAX_CONCURRENCY=8
RPC_MAX_RPS=10
RPC_BACKGROUND_CONCURRENCY=3
