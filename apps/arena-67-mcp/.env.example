# The Arena 67 backend this server reads from.
API_URL=http://localhost:9000
API_URL_DEV=http://localhost:9000

# Shared with the backend's SERVICE_SECRET. Sent on every backend request so
# the backend can identify this server rather than treating it as anonymous.
# Must be identical on both sides; 16 characters minimum.
#   openssl rand -hex 32
SERVICE_SECRET=

# Where this MCP server listens.
PORT=5100
MCP_PATH=/mcp

# Comma-separated. Leave unset to allow any.
# MCP_ALLOWED_HOSTS=localhost:5100
# MCP_ALLOWED_ORIGINS=http://localhost:3000

# Secret callers must present TO this server. Separate from SERVICE_SECRET,
# which this server presents to the backend — different direction, so a leak of
# one does not hand over the other. Unset means open.
# MCP_TOKEN=
